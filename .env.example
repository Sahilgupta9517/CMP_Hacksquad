# JanConnect AI / JanDrishti AI Environment Variables Example
# Copy this file to .env or .env.local and populate with your credentials

# Google Maps JavaScript API Configuration
# Get your API key from Google Cloud Console: https://console.cloud.google.com/
# Ensure Google Maps JavaScript API is enabled.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: Google Maps Map ID for AdvancedMarkerElement
# For development/testing, DEMO_MAP_ID can be used. For production, create a Map ID in Google Cloud Console.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Supabase Database Configuration (Optional - fallback to mockData if unconfigured)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
